# API runtime. Never commit real values to source control.
NODE_ENV=development
PORT=4040
CORS_ORIGINS=http://localhost:8082,https://inarikicchin.netlify.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
INARI_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
INARI_SESSION_TTL_MS=28800000

# Required only for the explicit first-admin seed operation.
INARI_BOOTSTRAP_ADMIN_EMAIL=
INARI_BOOTSTRAP_ADMIN_NAME=
INARI_BOOTSTRAP_ADMIN_PASSWORD=
