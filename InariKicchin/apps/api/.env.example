# Local development only. Use the hosting provider's secret manager in production.
NODE_ENV=development
PORT=4040
INARI_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
INARI_SESSION_TTL_MS=28800000
CORS_ORIGINS=http://localhost:3001

# Prisma schema and dependencies are being prepared. The production HTTP server is NOT wired to Prisma yet.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/inari_kicchin?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/inari_kicchin?schema=public

# One-time production seed inputs. Set only in a secure secret manager; never commit real values.
INARI_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
INARI_BOOTSTRAP_ADMIN_NAME=Restaurant Owner
INARI_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-16-plus-character-password
