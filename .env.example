# Inari Kicchin — environment template (Phase 5)
# Copy to apps/api/.env and fill real values. Never commit secrets.

NODE_ENV=development
PORT=4040

# Postgres (Supabase / Railway / self-hosted)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/inari_kicchin?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/inari_kicchin?schema=public

# Auth
INARI_TOKEN_SECRET=change-me-to-a-long-random-string
INARI_SESSION_TTL_MS=28800000

# Public web (if using Next later)
NEXT_PUBLIC_API_URL=http://localhost:4040
NEXT_PUBLIC_APP_NAME=Inari Kicchin

# Optional Phase 4 integrations (leave empty until owner approves)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# ETIMS_API_URL=
# ETIMS_CLIENT_ID=
# ETIMS_CLIENT_SECRET=
