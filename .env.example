# Template only. Never commit real secrets.
NODE_ENV=development
PORT=4040
INARI_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
INARI_SESSION_TTL_MS=28800000
CORS_ORIGINS=http://localhost:3001

# Planned Prisma database configuration. Not yet connected to production-server.ts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/inari_kicchin?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/inari_kicchin?schema=public

# Frontend public API origin (not a secret).
NEXT_PUBLIC_API_URL=http://localhost:4040
NEXT_PUBLIC_APP_NAME=Inari Kicchin

